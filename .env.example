# Application Settings
APP_NAME=HealthOS
DEBUG=False

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/healthos_db

# Security & Authentication
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256

# Token Expiration Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=HealthOS
FRONTEND_URL=http://localhost:5173

# Google OAuth Configuration
# Create credentials in Google Cloud Console and set these values in backend/.env
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Instructions:
# 1. Copy this file to backend/.env
# 2. Update all values in backend/.env with your actual configuration
# 3. Generate a strong SECRET_KEY using: openssl rand -hex 32
# 4. For Gmail SMTP, use App Password (not your regular password)
# 5. NEVER commit .env to version control - it contains sensitive credentials
